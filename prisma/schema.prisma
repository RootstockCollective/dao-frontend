generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DAO_DATA_DB_CONNECTION_STRING")
  schemas  = ["dao_data"]
}

model ProposalLike {
  id          Int      @id @default(autoincrement())
  proposalId  Bytes
  userAddress String   @db.VarChar(42)
  likedAt     DateTime @default(now()) @db.Timestamptz()
  reaction    String   @db.VarChar(50)

  @@unique([proposalId, userAddress, reaction], map: "unique_user_proposal")
  @@index([proposalId], map: "idx_proposal_likes_proposal_id")
  @@index([userAddress], map: "idx_proposal_likes_user_address")
  @@map("ProposalLikes")
  @@schema("dao_data")
}

/// Curated, app-owned configuration for a builder.
/// The indexer (see `@/lib/db`) owns the on-chain builder data and knows nothing
/// about this table, so the two are merged in application code, never in SQL.
/// `address` is the builder address, which is also the builder's id in the indexer
/// (`Builder.id`). Always stored lowercased.
model BuilderProfile {
  id        Int      @id @default(autoincrement())
  address   String   @unique(map: "unique_builder_profile_address") @db.VarChar(42)
  /// Either a root-relative path to an asset in `public/` (e.g. `/images/builders/foo.svg`)
  /// or a bare IPFS CID. Resolved for display by `IpfsAvatar`.
  image     String?  @db.VarChar(500)
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@map("BuilderProfiles")
  @@schema("dao_data")
}
